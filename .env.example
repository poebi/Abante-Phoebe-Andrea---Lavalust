# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_CHARSET=utf8mb4
# Optional: CA PEM path, e.g. /etc/secrets/aiven-ca.pem (verified TLS)
DB_SSL_CA=

# API signing secrets: generate separate random values of at least 32 characters.
JWT_SECRET=
REFRESH_TOKEN_KEY=
# Comma-separated frontend origins, e.g. http://localhost:3000,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
